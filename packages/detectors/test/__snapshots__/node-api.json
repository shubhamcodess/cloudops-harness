{
  "source": {
    "kind": "path",
    "ref": "node-api"
  },
  "workloadType": "service",
  "languages": [
    "typescript"
  ],
  "packageManager": "pnpm",
  "services": [
    {
      "name": "node-api",
      "path": ".",
      "language": "typescript",
      "kind": "service",
      "port": 3000,
      "buildCmd": "pnpm run build",
      "startCmd": "pnpm start",
      "hasDockerfile": true
    }
  ],
  "dockerable": true,
  "hasDockerfile": true,
  "hasCompose": false,
  "hasHelm": false,
  "hasTerraform": false,
  "hasK8sManifests": false,
  "ci": "github-actions",
  "datastores": [
    "postgres"
  ],
  "ai": {
    "isAi": false,
    "frameworks": [],
    "modelProviders": [],
    "vectorDbs": [],
    "mcpServer": false,
    "mcpClient": false,
    "needsSandbox": false
  },
  "envVars": [
    {
      "name": "DATABASE_URL",
      "classification": "secret",
      "file": ".env.example"
    },
    {
      "name": "JWT_SECRET",
      "classification": "secret",
      "file": ".env.example"
    },
    {
      "name": "LOG_LEVEL",
      "classification": "config",
      "file": ".env.example"
    },
    {
      "name": "PORT",
      "classification": "config",
      "file": ".env.example"
    }
  ],
  "pii": [],
  "evidence": [
    {
      "rule": "ci",
      "file": ".github/workflows/ci.yml"
    },
    {
      "rule": "datastore-dep",
      "file": "package.json",
      "detail": "postgres:pg"
    },
    {
      "rule": "dockerfile",
      "file": "Dockerfile"
    },
    {
      "rule": "env-var",
      "file": ".env.example",
      "detail": "DATABASE_URL:secret"
    },
    {
      "rule": "env-var",
      "file": ".env.example",
      "detail": "JWT_SECRET:secret"
    },
    {
      "rule": "env-var",
      "file": ".env.example",
      "detail": "LOG_LEVEL:config"
    },
    {
      "rule": "env-var",
      "file": ".env.example",
      "detail": "PORT:config"
    },
    {
      "rule": "language",
      "file": "src/server.ts",
      "detail": "typescript"
    },
    {
      "rule": "manifest",
      "file": "package.json"
    },
    {
      "rule": "package-manager",
      "file": "pnpm-lock.yaml",
      "detail": "pnpm"
    },
    {
      "rule": "service",
      "file": "package.json",
      "detail": "node-api:service"
    },
    {
      "rule": "workload:single-service",
      "detail": "service"
    }
  ]
}
