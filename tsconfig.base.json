{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@smc/contracts": ["./packages/contracts/src/index.ts"],
      "@smc/engine": ["./packages/engine/src/index.ts"],
      "@smc/detectors": ["./packages/detectors/src/index.ts"],
      "@smc/pricing": ["./packages/pricing/src/index.ts"],
      "@smc/policy": ["./packages/policy/src/index.ts"],
      "@smc/iac-gen": ["./packages/iac-gen/src/index.ts"],
      "@smc/verifier": ["./packages/verifier/src/index.ts"],
      "@smc/sop": ["./packages/sop/src/index.ts"],
      "@smc/app": ["./packages/app/src/index.ts"],
      "@smc/mcp": ["./packages/mcp/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"]
}
